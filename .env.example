# 从 https://my.telegram.org 获取
API_ID=12345678
API_HASH=your_api_hash_here
SESSION_NAME=user

# 国内必填：本地代理地址（与 VPN/Clash 端口一致）
# TELEGRAM_PROXY=socks5://127.0.0.1:7890

SOURCE_CHANNELS=@source_channel1,@source_channel2
TARGET_CHANNEL=@my_own_channel

# FILTER_KEYWORDS=关键词1,关键词2
# BLOCKED_KEYWORDS=vpn,机场,推广,广告,博彩
# FORWARD_HEADER=📢 快讯：

# true=复制图文发送（推荐）；false=原生转发带来源
COPY_WITHOUT_FORWARD_TAG=true
# STRIP_SOURCE_REFS=true

# AI 复写（仅处理文字/图片说明，媒体文件原样保留）
AI_ENABLED=false
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# AI_PROMPT=自定义系统提示词（留空则用频道结构化模板）
# TEMPLATE_EXTRACT_ENABLED=true
# PUBLISH_TEMPLATE=名字:{name}\n年龄:{age}\n一次价格:{price_once}\n两次价格:{price_twice}\n地区:{region}\n电报:{telegram}\n频道:{channel}\n双向:{duplex}
# AUTO_PUBLISH=true
# REQUIRE_MEDIA=false
# DAILY_FETCH_ENABLED=true
# DAILY_FETCH_TIME=03:00
# DAILY_FETCH_LIMIT=30
# FETCH_ON_START=false

# TG Bot 推送
# BOT_ENABLED=true
# BOT_TOKEN=123456:abcdef
# BOT_CHAT_ID=123456789
