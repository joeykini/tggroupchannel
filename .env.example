# 从 https://my.telegram.org 获取
API_ID=12345678
API_HASH=your_api_hash_here
SESSION_NAME=user

SOURCE_CHANNELS=@source_channel1,@source_channel2
TARGET_CHANNEL=@my_channel

# FILTER_KEYWORDS=关键词1,关键词2
# BLOCKED_KEYWORDS=vpn,机场,梯子,翻墙,代理,节点,clash,v2ray,trojan,ssr,广告,推广,博彩,招商,中奖,口令红包,工兵券
# FORWARD_HEADER=📢 快讯：

# true=复制图文发送（推荐）；false=原生转发带来源
COPY_WITHOUT_FORWARD_TAG=true
# STRIP_SOURCE_REFS=true

# AI 复写（关闭时默认按模板提取字段并重排）
AI_ENABLED=false
# TEMPLATE_EXTRACT_ENABLED=true
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_PROMPT=自定义系统提示词

# AUTO_PUBLISH=true
# REQUIRE_MEDIA=false

# 内容去重（按昵称+地区+项目+价格指纹）
# CONTENT_DEDUP_ENABLED=true

# 源频道同步：对比删帖、补抓遗漏、指纹去重
# SYNC_ENABLED=true
# SYNC_INTERVAL_MINUTES=60
# SYNC_SCAN_LIMIT=200
# DELETE_FROM_TARGET_ON_SOURCE_REMOVED=false

# 每日定时补抓
# DAILY_FETCH_ENABLED=true
# DAILY_FETCH_TIME=03:00
# DAILY_FETCH_LIMIT=30
# FETCH_ON_START=false

# TG Bot 推送 + 管理
# BOT_ENABLED=true
# BOT_TOKEN=123456:abcdef
# BOT_CHAT_ID=123456789
# BOT_ADMIN_IDS=123456789,987654321
