# 从 https://my.telegram.org 获取
API_ID=12345678
API_HASH=your_api_hash_here
SESSION_NAME=user

SOURCE_CHANNELS=@source_channel1,@source_channel2
TARGET_CHANNEL=@my_channel

# FILTER_KEYWORDS=关键词1,关键词2
# BLOCKED_KEYWORDS=vpn,机场,梯子,翻墙,代理,节点,clash,v2ray,trojan,ssr,广告,推广,博彩,招商,中奖,口令红包,工兵券
# FORWARD_HEADER=📢 快讯：

# true=复制图文发送（推荐）；false=原生转发带来源
COPY_WITHOUT_FORWARD_TAG=true
# STRIP_SOURCE_REFS=true

# AI 复写（关闭时默认按模板提取字段并重排）
AI_ENABLED=false
# TEMPLATE_EXTRACT_ENABLED=true
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_PROMPT=自定义系统提示词

# AUTO_PUBLISH=true
# REQUIRE_MEDIA=false

# 统一榜 + 出勤同步
# TARGET_CHANNEL=@huaianbendi
# SOURCE_CHANNELS=@huaian008,@huaian0901
# ROSTER_ENABLED=true
# ROSTER_GROUP_1=@HuaiAnHub
# ROSTER_CHANNEL_1=@huaian008
# ROSTER_GROUP_2=@HuaiAn_YangZhou
# ROSTER_CHANNEL_2=@huaian0901
# ROSTER_TRIGGER_KEYWORD=出勤
# ROSTER_BOT_NAMES=修车小助手
# DELETE_INACTIVE_FROM_TARGET=true
# ROSTER_SYNC_ENABLED=true
# ROSTER_SYNC_INTERVAL_MINUTES=120

# BLOCKED_KEYWORDS=vpn,机场,广告,商k

# 本地区限制（默认淮安 7 区县，非本地不入人员库）
# REGION_FILTER_ENABLED=true
# ALLOWED_REGIONS=清江浦区,淮阴区,淮安区,洪泽区,涟水县,盱眙县,金湖县

# 凌晨任务（默认 02:30）：补抓→源站同步→出勤比对→可选自动发布
# NIGHTLY_JOB_ENABLED=true
# ROSTER_SYNC_DAILY_ENABLED=true
# ROSTER_SYNC_TIME=02:30
# AUTO_PUBLISH_AFTER_ROSTER=false
# PUBLISH_INTERVAL_SECONDS=30

# 源频道同步：对比删帖、补抓遗漏、指纹去重
# SYNC_ENABLED=true
# SYNC_INTERVAL_MINUTES=60
# SYNC_SCAN_LIMIT=200
# DELETE_FROM_TARGET_ON_SOURCE_REMOVED=false

# 每日定时补抓
# DAILY_FETCH_ENABLED=true
# DAILY_FETCH_TIME=03:00
# DAILY_FETCH_LIMIT=30
# FETCH_ON_START=false

# TG Bot 推送 + 管理
# BOT_ENABLED=true
# BOT_TOKEN=123456:abcdef
# BOT_CHAT_ID=123456789
# BOT_ADMIN_IDS=123456789,987654321
